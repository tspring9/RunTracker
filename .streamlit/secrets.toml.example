# RunTracker settings -- TEMPLATE, safe to commit.
#
# Copy this file to .streamlit/secrets.toml and fill in real values:
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is gitignored and must never be committed. Every
# setting below is also readable from an environment variable of the same
# name -- secrets.toml wins when both are present. Nothing here is required
# to run the app locally; see the notes against each one.
#
# When deploying to Streamlit Community Cloud, do not upload this file.
# Paste the same key = "value" lines into
# Manage app -> Settings -> Secrets instead.


# -------------------------------------------------------------------
# RunSignUp API caller registration  (REQUIRED BEFORE 2027-01-01)
# -------------------------------------------------------------------
# From 2027-01-01, RunSignUp rejects calls from unregistered API callers,
# which would take down every RunSignUp feature in the app. Registration is
# free: log in to RunSignUp -> API Keys -> "Register as an API caller".
#
# Set BOTH of these or NEITHER. A token RunSignUp does not recognise fails
# *every* call today with HTTP 400 "Invalid API caller credentials." -- so a
# half-finished or mis-pasted setup is worse than leaving both unset.
#
# After editing, verify with:
#     python runsignup_results.py --check-registration
#
# RUNSIGNUP_API_REG_TOKEN  = "12345.abcdef0123456789abcdef0123456789"   # "<id>.<token>"
# RUNSIGNUP_API_REG_SECRET = "replace-with-the-secret-shown-once-at-registration"


# -------------------------------------------------------------------
# RunSignUp race search (optional)
# -------------------------------------------------------------------
# Only the race-*search* endpoint benefits from these. The public results
# endpoints need no credentials -- results work with this whole section
# commented out. Separate from the registration values above: a call can be
# registered and still unauthenticated.
#
# RUNSIGNUP_API_KEY    = ""
# RUNSIGNUP_API_SECRET = ""


# -------------------------------------------------------------------
# RunSignUp affiliate program (optional)
# -------------------------------------------------------------------
# Appends ?afmc=<token> to outbound race links. Unset == plain links.
#
# RUNSIGNUP_AFFILIATE_TOKEN = ""


# -------------------------------------------------------------------
# RunTracker local settings (optional)
# -------------------------------------------------------------------
# Pins which user's rows the app loads. Unset == the app's default.
# RUNTRACKER_USER_ID = ""
#
# Where the SQLite file lives. Unset == storage.py's default. Community
# Cloud's filesystem is ephemeral, so a path there does not survive a
# restart; see storage.py.
# RUNTRACKER_DB_PATH = ""
